# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.production

# ── Uploads & Storage (user files — don't commit) ──────────────
/uploads/*
!/uploads/.gitkeep
/private_storage/*
!/private_storage/.gitkeep
*.sqlite
*.sqlite-journal

# ── System files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────
*.log
/logs/

# ── Composer (if used later) ──────────────────────────────────
/vendor/
composer.lock

# ── Node (if used later) ──────────────────────────────────────
node_modules/
npm-debug.log*

# ── Build artifacts ───────────────────────────────────────────
/dist/
/build/

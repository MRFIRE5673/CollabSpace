# CollabSpace — Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit your actual .env file to Git!

# ── Database (PostgreSQL) ────────────────────────────────────
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collab_workspace
DB_USER=postgres
DB_PASS=your_password_here

# Full connection string alternative (e.g. Supabase, Neon, Render, Railway):
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/collab_workspace

# ── App ──────────────────────────────────────────────────────
APP_URL=http://localhost
APP_ENV=local

# ── Security ─────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-random-string-here
